const QC = { SHEETS: { Users:['id','username','displayName','salt','hash','createdAt','status'], Sessions:['id','userId','expiresAt'], Friends:['id','fromId','toId','status','createdAt'], Chats:['id','name','type','createdAt','updatedAt'], Members:['id','chatId','userId','role','lastReadAt'], Messages:['id','chatId','senderId','text','requestId','createdAt'], Notifications:['id','userId','type','title','body','chatId','sourceId','read','createdAt'], Presence:['id','userId','lastActiveAt'], Typing:['id','chatId','userId','expiresAt'] } };
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Quvo Chat').addMetaTag('viewport','width=device-width, initial-scale=1');}
function db_(){const p=PropertiesService.getScriptProperties();let id=p.getProperty('QC_SHEET_ID');if(!id)throw Error('先に setup() を実行してください');return SpreadsheetApp.openById(id);}
function setup(){const p=PropertiesService.getScriptProperties();let id=p.getProperty('QC_SHEET_ID');let ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('Quvo Chat Database');if(!id)p.setProperty('QC_SHEET_ID',ss.getId());Object.entries(QC.SHEETS).forEach(([n,h])=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0)s.appendRow(h);else {let cur=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];h.filter(k=>!cur.includes(k)).forEach(k=>s.getRange(1,s.getLastColumn()+1).setValue(k));}});return {spreadsheetUrl:ss.getUrl()};}
function sheet_(name){const s=db_().getSheetByName(name);if(!s)throw Error('Missing sheet: '+name);return s;}
function all_(name){const s=sheet_(name),v=s.getDataRange().getValues();if(v.length<2)return [];const h=v[0].map(String);return v.slice(1).map((a,i)=>Object.fromEntries([...h.map((k,j)=>[k,a[j]]),['_row',i+2]]));}
function add_(name,obj){const s=sheet_(name),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(k=>obj[k]??''));return obj;}
function patch_(name,id,data){const s=sheet_(name),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0],r=all_(name).find(x=>x.id===id);if(!r)throw Error('対象が見つかりません');Object.entries(data).forEach(([k,v])=>{let c=h.indexOf(k);if(c>=0)s.getRange(r._row,c+1).setValue(v);});}
function uuid_(){return Utilities.getUuid();}
function now_(){return new Date().toISOString();}
function hash_(password,salt){let bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+password);return Utilities.base64Encode(bytes);}
function checkText_(s,max){if(typeof s!=='string'||!s.trim()||s.length>max)throw Error('入力内容が無効です');return s.trim();}
function lock_(fn){let l=LockService.getScriptLock();l.waitLock(20000);try{return fn();}finally{l.releaseLock();}}
function user_(token){if(typeof token!=='string'||!token)throw Error('ログインしてください');let session=all_('Sessions').find(s=>s.id===token);if(!session||Date.parse(session.expiresAt)<Date.now())throw Error('セッションが無効です。再ログインしてください');let u=all_('Users').find(x=>x.id===session.userId);if(!u||u.status!=='active')throw Error('このアカウントは利用できません');return u;}
function public_(u){return {id:u.id,username:u.username,displayName:u.displayName};}
function register(username,displayName,password){username=checkText_(username,30).toLowerCase();displayName=checkText_(displayName,40);if(!/^[a-z0-9_]{3,30}$/.test(username))throw Error('ユーザー名は英数字と_で3〜30文字');if(typeof password!=='string'||password.length<10||password.length>128)throw Error('パスワードは10〜128文字');return lock_(()=>{if(all_('Users').some(u=>u.username===username))throw Error('ユーザー名は使用されています');let salt=uuid_(),u=add_('Users',{id:uuid_(),username,displayName,salt,hash:hash_(password,salt),createdAt:now_(),status:'active'});return createSession_(u);});}
function createSession_(u){let token=uuid_()+uuid_();add_('Sessions',{id:token,userId:u.id,expiresAt:new Date(Date.now()+7*86400000).toISOString()});return {token,user:public_(u)};}
function login(username,password){username=String(username||'').trim().toLowerCase();const key='login_'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,username)).slice(0,40);const cache=CacheService.getScriptCache();let count=Number(cache.get(key)||0);if(count>=5)throw Error('ログイン試行が多すぎます。15分後にお試しください');const u=all_('Users').find(x=>x.username===username);if(!u||u.status!=='active'||hash_(String(password||''),u.salt)!==u.hash){cache.put(key,String(count+1),900);throw Error('ユーザー名またはパスワードが違います');}cache.remove(key);return createSession_(u);}
function logout(token){let s=all_('Sessions').find(x=>x.id===token);if(s){let sh=sheet_('Sessions');sh.deleteRow(s._row);}return true;}
function me(token){return public_(user_(token));}
function searchUsers(token,query){const me=user_(token),q=checkText_(query,50).toLowerCase();return all_('Users').filter(u=>u.id!==me.id&&u.status==='active'&&(u.username.toLowerCase().includes(q)||String(u.displayName).toLowerCase().includes(q))).slice(0,20).map(public_);}
function friendRequests(token){let u=user_(token),users=all_('Users');return all_('Friends').filter(f=>(f.fromId===u.id||f.toId===u.id)).map(f=>({...f,other:public_(users.find(x=>x.id===(f.fromId===u.id?f.toId:f.fromId))||{id:'',username:'',displayName:'不明'})}));}
function requestFriend(token,toId){let u=user_(token);if(toId===u.id)throw Error('自分には申請できません');return lock_(()=>{let target=all_('Users').find(x=>x.id===toId&&x.status==='active');if(!target)throw Error('ユーザーが見つかりません');if(all_('Friends').some(f=>(f.fromId===u.id&&f.toId===toId)||(f.fromId===toId&&f.toId===u.id)))throw Error('申請済みです');let f=add_('Friends',{id:uuid_(),fromId:u.id,toId,status:'pending',createdAt:now_()});notify_({userId:toId,type:'friend',title:'友だち申請',body:u.displayName+'さんから申請が届きました',sourceId:f.id});return true;});}
function respondFriend(token,id,accept){let u=user_(token);return lock_(()=>{let f=all_('Friends').find(x=>x.id===id&&x.toId===u.id&&x.status==='pending');if(!f)throw Error('申請が見つかりません');patch_('Friends',id,{status:accept?'accepted':'rejected'});return true;});}
function friends_(u){return all_('Friends').filter(f=>f.status==='accepted'&&(f.fromId===u.id||f.toId===u.id)).map(f=>f.fromId===u.id?f.toId:f.fromId);}
function listFriends(token){let u=user_(token),ids=new Set(friends_(u));return all_('Users').filter(x=>ids.has(x.id)).map(public_);}
function requireMember_(u,chatId){let m=all_('Members').find(x=>x.chatId===chatId&&x.userId===u.id);if(!m)throw Error('このチャットにはアクセスできません');return m;}
function startChat(token,otherId){let u=user_(token);if(!friends_(u).includes(otherId))throw Error('友だちのみチャットできます');return lock_(()=>{let matches=all_('Members').filter(m=>m.userId===u.id).map(m=>m.chatId);let existing=all_('Chats').find(c=>c.type==='private'&&matches.includes(c.id)&&all_('Members').some(m=>m.chatId===c.id&&m.userId===otherId));if(existing)return existing.id;let id=uuid_();add_('Chats',{id,name:'',type:'private',createdAt:now_(),updatedAt:now_()});[u.id,otherId].forEach(userId=>add_('Members',{id:uuid_(),chatId:id,userId,role:'member',lastReadAt:''}));return id;});}
function createGroup(token,name,ids){let u=user_(token);name=checkText_(name,60);if(!Array.isArray(ids)||ids.length>50)throw Error('メンバーが多すぎます');let allowed=new Set(friends_(u));let members=[...new Set([u.id,...ids])];if(members.some(id=>id!==u.id&&!allowed.has(id)))throw Error('友だちのみ追加できます');return lock_(()=>{let id=uuid_();add_('Chats',{id,name,type:'group',createdAt:now_(),updatedAt:now_()});members.forEach(userId=>add_('Members',{id:uuid_(),chatId:id,userId,role:userId===u.id?'owner':'member',lastReadAt:''}));return id;});}
function listChats(token){let u=user_(token),ms=all_('Members').filter(m=>m.userId===u.id),chats=all_('Chats'),members=all_('Members'),users=all_('Users'),messages=all_('Messages');return ms.map(m=>{let c=chats.find(x=>x.id===m.chatId);if(!c)return null;let others=members.filter(x=>x.chatId===c.id&&x.userId!==u.id),other=users.find(x=>x.id===others[0]?.userId);let msgs=messages.filter(x=>x.chatId===c.id),last=msgs[msgs.length-1];return {id:c.id,name:c.type==='group'?c.name:(other?.displayName||'チャット'),type:c.type,updatedAt:c.updatedAt,lastText:last?.text||'',unread:msgs.filter(x=>x.senderId!==u.id&&(!m.lastReadAt||Date.parse(x.createdAt)>Date.parse(m.lastReadAt))).length};}).filter(Boolean).sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt)));}
function chatMembers(token,chatId){let u=user_(token);requireMember_(u,chatId);let ids=new Set(all_('Members').filter(m=>m.chatId===chatId).map(m=>m.userId));return all_('Users').filter(x=>ids.has(x.id)).map(public_);}
function getMessages(token,chatId){let u=user_(token);requireMember_(u,chatId);let users=all_('Users');return all_('Messages').filter(m=>m.chatId===chatId).slice(-100).map(m=>({id:m.id,senderId:m.senderId,senderName:users.find(x=>x.id===m.senderId)?.displayName||'ユーザー',text:m.text,createdAt:m.createdAt}));}
function notify_(n){if(all_('Notifications').some(x=>x.userId===n.userId&&x.type===n.type&&x.sourceId===n.sourceId))return;add_('Notifications',{id:uuid_(),userId:n.userId,type:n.type,title:n.title,body:String(n.body||'').slice(0,250),chatId:n.chatId||'',sourceId:n.sourceId,read:false,createdAt:now_()});}
function sendMessage(token,chatId,text,requestId){text=checkText_(text,5000);requestId=checkText_(requestId,100);return lock_(()=>{let u=user_(token);requireMember_(u,chatId);let old=all_('Messages').find(m=>m.chatId===chatId&&m.senderId===u.id&&m.requestId===requestId);if(old)return {id:old.id,duplicate:true};let msg=add_('Messages',{id:uuid_(),chatId,senderId:u.id,text,requestId,createdAt:now_()});patch_('Chats',chatId,{updatedAt:msg.createdAt});all_('Members').filter(m=>m.chatId===chatId&&m.userId!==u.id).forEach(m=>notify_({userId:m.userId,type:'message',title:u.displayName+'さんからメッセージ',body:text,chatId,sourceId:msg.id}));return {id:msg.id,duplicate:false};});}
function markRead(token,chatId){let u=user_(token),m=requireMember_(u,chatId);patch_('Members',m.id,{lastReadAt:now_()});return true;}
function heartbeat(token){let u=user_(token),p=all_('Presence').find(x=>x.userId===u.id);if(p)patch_('Presence',p.id,{lastActiveAt:now_()});else add_('Presence',{id:uuid_(),userId:u.id,lastActiveAt:now_()});return true;}
function presence(token,ids){let u=user_(token);if(!Array.isArray(ids)||ids.length>50)throw Error('入力が無効です');let visible=new Set(all_('Members').filter(m=>m.userId===u.id).flatMap(m=>all_('Members').filter(x=>x.chatId===m.chatId).map(x=>x.userId)));let ps=all_('Presence');return ids.filter(id=>visible.has(id)).map(id=>({userId:id,online:ps.some(p=>p.userId===id&&Date.now()-Date.parse(p.lastActiveAt)<90000)}));}
function setTyping(token,chatId,active){let u=user_(token);requireMember_(u,chatId);let t=all_('Typing').find(x=>x.chatId===chatId&&x.userId===u.id),expiresAt=new Date(Date.now()+(active?8000:-1000)).toISOString();if(t)patch_('Typing',t.id,{expiresAt});else add_('Typing',{id:uuid_(),chatId,userId:u.id,expiresAt});return true;}
function getTyping(token,chatId){let u=user_(token);requireMember_(u,chatId);let users=all_('Users');return all_('Typing').filter(t=>t.chatId===chatId&&t.userId!==u.id&&Date.parse(t.expiresAt)>Date.now()).map(t=>users.find(x=>x.id===t.userId)?.displayName||'ユーザー');}
function notifications(token){let u=user_(token);return all_('Notifications').filter(n=>n.userId===u.id).slice(-100).reverse().map(n=>({id:n.id,title:n.title,body:n.body,chatId:n.chatId,type:n.type,read:String(n.read)==='true',createdAt:n.createdAt}));}
function readNotification(token,id){let u=user_(token),n=all_('Notifications').find(x=>x.id===id&&x.userId===u.id);if(!n)throw Error('通知が見つかりません');patch_('Notifications',id,{read:true});return true;}
function deleteNotification(token,id){let u=user_(token),n=all_('Notifications').find(x=>x.id===id&&x.userId===u.id);if(!n)throw Error('通知が見つかりません');sheet_('Notifications').deleteRow(n._row);return true;}
